# ============================================
# CareRoute AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in values.

# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careroute
JWT_SECRET=change-this-to-a-strong-random-secret-key
GEMINI_API_KEY=
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:8000

# Frontend (VITE_ prefix required for Vite)
VITE_API_URL=http://localhost:8000

# Map Configuration (optional - uses OpenStreetMap/Leaflet by default)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
