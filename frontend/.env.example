# API base URL.
# Local development: leave empty to use the Vite dev-server proxy (/api -> localhost:8000),
# or set explicitly, e.g. http://localhost:8000
# Production: set to your deployed backend URL, e.g. https://api.careroute.example.com
VITE_API_URL=

# Optional: custom map tile server (defaults to OpenStreetMap tiles in the map components)
VITE_MAP_TILE_URL=
